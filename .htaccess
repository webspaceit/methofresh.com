# ---------------------------------------------------------------------------
# Front controller.
#
# This file must work BOTH at a domain root (production: https://methofresh.com/)
# and inside a sub-directory of the document root (local dev:
# http://localhost/methofresh.com/).
#
# NEVER hardcode "RewriteBase" here. A RewriteBase that does not match the live
# URL prefix makes the rewrite target repeat itself, and Apache then aborts every
# rewritten URL with:
#     500 Internal Server Error
#     AH00124: Request exceeded the limit of 10 internal redirects
# which takes down the whole dashboard, login, products and every /assets/ image.
# ---------------------------------------------------------------------------

DirectoryIndex wsit_index.php

RewriteEngine On

# ---------------------------------------------------------------------------
# Never expose project internals over HTTP (config, code, schema, tooling).
# The front controller and real files stay reachable; only these paths 403.
# ---------------------------------------------------------------------------
RewriteRule ^(?:app|database|vendor|node_modules|resources)(?:/|$) - [F,L]
RewriteRule ^composer\.(?:json|lock)$ - [F,L]
RewriteRule ^(?:package|package-lock)\.json$ - [F,L]
RewriteRule ^tailwind\.config\.js$ - [F,L]
RewriteRule ^\.(?!well-known(?:/|$)) - [F,L]

# Serve uploaded product images / assets that live under public/assets.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^assets/(.*)$ public/assets/$1 [L]

# Route everything that is not a real file or directory to the front
# controller. The last condition guarantees the front controller can never
# rewrite onto itself, which would spin into an internal redirect loop.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !/wsit_index\.php$
RewriteRule ^ wsit_index.php [QSA,L]

<IfModule mod_setenvif.c>
    # Bundled assets (CSS/JS/fonts) are cache-busted with ?v=<mtime> via the
    # asset_url() helper, so they can be cached "forever". Images are often
    # overwritten in place, so they get a long but finite TTL instead.
    SetEnvIf Request_URI "\.(?:css|js|woff2?|ttf)(\?.*)?$" MF_ASSET_LONG
    SetEnvIf Request_URI "\.(?:svg|png|jpe?g|webp|gif|ico|avif)(\?.*)?$" MF_ASSET_IMG

    # Leave CSS/JS uncompressed at the origin. Cloudflare never re-encodes an
    # origin gzip as brotli/zstd -- it passes the gzip straight through -- so
    # handing the edge an uncompressed body is the only way browsers get the
    # better encoding (~10-18% smaller than gzip for these files). See the
    # RequestHeader below, which does the same thing for any compressor that
    # does not honour "no-gzip".
    SetEnvIfNoCase Request_URI "\.(?:css|js)(\?.*)?$" no-gzip
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Cache-Control "public, max-age=31536000, immutable" env=MF_ASSET_LONG
    Header set Cache-Control "public, max-age=2592000" env=MF_ASSET_IMG

    # The app never varies its output by Accept-Encoding itself (compression is
    # handled at the edge), but the server's compressor advertises it here and
    # Cloudflare appends its own, producing a duplicate
    # "Vary: Accept-Encoding, Accept-Encoding". Drop the origin copy.
    Header unset Vary

    # Strip the client's Accept-Encoding before the compressor can act on it.
    # Late-mode RequestHeader runs in the fixup phase, i.e. before Apache's
    # output filters (mod_deflate's DEFLATE) are inserted, so the origin hands
    # Cloudflare uncompressed CSS/JS and lets the edge pick the best encoding
    # the client supports. Cloudflare does not recompress an origin gzip, so
    # without this the browser only ever sees gzip.
    RequestHeader unset Accept-Encoding

    # Standalone .php helpers dropped into the document root (e.g. the temporary
    # OPcache-clearing script used on deploy) advertise no cache policy of their
    # own and can otherwise be cached at the edge for hours. The front controller
    # (wsit_index.php) is excluded: it already sends its own no-store headers via
    # the session, and setting them again here would duplicate the header.
    <FilesMatch "^(?!wsit_index\.php$).+\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
